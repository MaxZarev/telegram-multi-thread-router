BOT_TOKEN=123456789:AAHfiqksKZ8...
OWNER_USER_ID=123456789
AUTH_TOKEN=your-secret-token-here
ENABLE_CODEX=false
DEFAULT_PROVIDER=claude
STREAM_INTERMEDIATE_MESSAGES=true
# Voice transcription backend: "whisper" (local, CPU) or "deepgram" (cloud API)
TRANSCRIBER=whisper
# Required only if TRANSCRIBER=deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Logging
# LOG_DIR=logs
# LOG_LEVEL=INFO
# TURN_WARN_SECONDS=300
# TURN_ERROR_SECONDS=900
